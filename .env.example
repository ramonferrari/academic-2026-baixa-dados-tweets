# X / Twitter API v2 Credentials
# Obtenha suas chaves em: https://developer.x.com/en/portal/dashboard

# O Bearer Token é o principal e suficiente para leitura (busca, tweets, perfis públicos).
X_BEARER_TOKEN=seu_bearer_token_aqui

# Configurações de Segurança e Orçamento
# Estimativa da API do X: US$ 0,005 por tweet retornado (US$ 5,00 por 1.000 tweets)
MAX_BUDGET_USD=5.00
MAX_TWEETS_LIMIT=1000
